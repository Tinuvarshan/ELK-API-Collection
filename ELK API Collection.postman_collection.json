      "name": "User Management",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function(){\r",
                  "\r",
                  "    pm.response.to.have.status(201);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "let jsonData = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"user_id\", jsonData.userId);\r",
                  "\r",
                  "pm.test(\"User created successfully\", function(){\r",
                  "\r",
                  "    pm.response.to.have.status(201);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"User ID generated\", function(){\r",
                  "\r",
                  "    let data = pm.response.json();\r",
                  "\r",
                  "    pm.expect(data).to.have.property(\"userId\");\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"SLA Violation\", function () {\r",
                  "\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
                  "\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n\"name\":\"test\",\r\n\"email\":\"ajay@test.com\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://smell-brass-ppc-relatives.trycloudflare.com/users",
              "protocol": "https",
              "host": [
                "smell-brass-ppc-relatives",
                "trycloudflare",
                "com"
              ],
